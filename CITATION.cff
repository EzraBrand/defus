cff-version: 1.2.0
message: "If you use this edition, please cite it as below."
title: "Defus: open scans of printed Hebrew books"
type: dataset
authors:
  - family-names: Brand
    given-names: Ezra
abstract: "Open scans of printed Hebrew books and Judaica, 1469–1920, gathered from the libraries that hold them. Harvested from library catalogues (HathiTrust, Internet Archive, Munich, Frankfurt and others); editions grouped into works. The scans stay with the libraries; rights are per copy."
license: CC-BY-SA-4.0
url: "https://openseforim.org/defus/"
repository-code: "https://github.com/openseforim/defus"
keywords:
  - "Judaica"
  - "Hebrew"
  - "digital humanities"
  - "translation"
  - "digital edition"
